{
  "name": "learnova-nextjs-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:student": "npm --workspace=@learnova/student run dev",
    "dev:teacher": "npm --workspace=@learnova/teacher run dev",
    "dev:admin": "npm --workspace=@learnova/admin run dev",
    "test:shared": "node --experimental-strip-types --test packages/shared/src/utils/dag.test.ts packages/shared/src/utils/assessment.test.ts packages/shared/src/utils/studentLogic.test.ts packages/shared/src/utils/adminLogic.test.ts",
    "test:backend": "python -m pytest backend/tests/test_ai_persistent_sessions.py backend/tests/test_ai_adapter.py backend/tests/test_ai_privacy.py backend/tests/test_agy_running_integration.py -v",
    "test": "npm run test:shared && npm run test:backend"
  }
}
